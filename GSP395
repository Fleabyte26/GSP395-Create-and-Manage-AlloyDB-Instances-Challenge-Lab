4. Read pool and backup (10–15 min)
bash
gcloud beta alloydb backups create lab-backup --cluster=lab-cluster --region=$REGION --project=$PROJECT_ID --async
gcloud beta alloydb instances create lab-instance-rp1 --instance-type=READ_POOL --cpu-count=2 --read-pool-node-count=2 --region=$REGION --cluster=lab-cluster --project=$PROJECT_ID
